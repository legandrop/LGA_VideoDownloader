<RCC>
    <!-- dark_theme.qss quedo desactualizado y ya no se carga: el estilo real es
         Theme::styleSheet() (src/ui/theme.cpp). -->
    <qresource prefix="/styles">
        <file>styles/dark_theme.qss</file>
    </qresource>
    <qresource prefix="/icons">
        <!-- Barra de titulo: el icono de la app (el PNG de 256 del .ico) y los dibujos de
             Settings y Help, copia byte a byte de los de FaceLock y RotoWorker. -->
        <file alias="app_256.png">icons/app_256.png</file>
        <file alias="settings.svg">icons/settings.svg</file>
        <file alias="help.svg">icons/help.svg</file>
    </qresource>
    <!-- Inter embebida (la carga Theme::apply). Inter-SemiBold es el peso 600. -->
    <qresource prefix="/">
        <file>fonts/Inter-Regular.ttf</file>
        <file>fonts/Inter-Medium.ttf</file>
        <file>fonts/Inter-SemiBold.ttf</file>
    </qresource>
</RCC>
